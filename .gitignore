# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*

# Local paper-trading run state -- never commit real run output
data/
*.log

# Raw historical trade data used to derive behavior_config.py's numbers --
# ~684MB, not code, not something to version in git. The derived summary
# (trade_behavioral_analysis.json) and the script that produced it
# (analyze_trades.py) ARE kept, as provenance for behavior_config.py.
trade.jsonl

# OS cruft
.DS_Store

# Claude Code session state -- not project files
.claude/

# Local-only trader intelligence -- consolidated derived facts about the
# real wallet this bot's behavior is calibrated on. Deliberately never
# committed: unlike behavior_config.py's tables (which document the BOT's
# own calibration and are meant to be public), this file exists purely as
# private reference material, per explicit request.
TRADER_PROFILE.md

# Private keys / credentials -- never commit these, regardless of name
*.pem
*.key
.aws/

# Local-only ongoing trader-intelligence pipeline (fetch/analysis scripts
# are fine to keep private-source-controlled on the AWS box itself, but
# never in this public repo -- same reasoning as TRADER_PROFILE.md above:
# it's research on a real wallet's behavior, not the bot's own code).
trader_intel/
